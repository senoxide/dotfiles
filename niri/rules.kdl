window-rule {
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width {
        fixed 1020
    }
    default-window-height {
        fixed 900
    }
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
